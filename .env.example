# Copia este archivo a .env y completa los valores con tu proyecto Firebase.
# Este archivo no debe contener datos reales si se va a subir al repositorio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: credenciales del superadmin local (si tu app las utiliza)
VITE_SUPERADMIN_USER=
VITE_SUPERADMIN_PASSWORD=
